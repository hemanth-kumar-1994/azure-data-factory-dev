{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azure-data-factory-noob"
		},
		"sourcelinkedservice_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'sourcelinkedservice'"
		},
		"targetlinkedservice_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'targetlinkedservice'"
		},
		"sourcelinkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageacc26.dfs.core.windows.net/"
		},
		"targetlinkedservice_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "PRACTICE"
		},
		"targetlinkedservice_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"targetlinkedservice_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "hfqjfqw-bl64933.snowflakecomputing.com"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azure-data-factory-noob_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"sourcelinkedservice_accountKey": {
						"value": "[parameters('sourcelinkedservice_accountKey')]"
					},
					"targetlinkedservice_password": {
						"value": "[parameters('targetlinkedservice_password')]"
					},
					"sourcelinkedservice_properties_typeProperties_url": {
						"value": "[parameters('sourcelinkedservice_properties_typeProperties_url')]"
					},
					"targetlinkedservice_properties_typeProperties_database": {
						"value": "[parameters('targetlinkedservice_properties_typeProperties_database')]"
					},
					"targetlinkedservice_properties_typeProperties_role": {
						"value": "[parameters('targetlinkedservice_properties_typeProperties_role')]"
					},
					"targetlinkedservice_properties_typeProperties_host": {
						"value": "[parameters('targetlinkedservice_properties_typeProperties_host')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}